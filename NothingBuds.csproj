<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyName>NothingBuds</AssemblyName>
    <RootNamespace>NothingBuds</RootNamespace>
    <!-- Single-file publish ready; tray autostart handled at runtime -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Nothing brand fonts extracted from the official app -->
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Official buds renders (res/drawable) for the hero card -->
    <Resource Include="Assets\Buds\*.png" />
  </ItemGroup>

</Project>
