<Window x:Class="NothingBuds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NothingBuds" Height="780" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- Brand header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,10,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="NOTHING(BUDS)" FontFamily="{StaticResource NDot}" FontSize="26"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Unofficial on-device companion · 100% local"
                               Foreground="{StaticResource MutedBrush}" Margin="20,2,0,0" FontSize="12"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="Refresh_Click"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <!-- Multi-device switch (mobile-app style toggle) -->
            <GroupBox x:Name="DeviceSwitcherPanel" Visibility="Collapsed" Header="Active device">
                <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name"
                          SelectionChanged="DeviceCombo_SelectionChanged"
                          DropDownOpened="DeviceCombo_Opened" DropDownClosed="DeviceCombo_Closed"
                          PreviewKeyDown="Combo_EscMark"/>
            </GroupBox>

            <StackPanel x:Name="DeviceControls">
                <!-- Hero -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="DeviceNameText" Text="No device"
                                   FontFamily="{StaticResource Serif}" FontSize="26"
                                   Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" Text="Disconnected"
                                   Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                        <TextBlock x:Name="FirmwareText" Text="Firmware: —"
                                   Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                        <Grid Margin="0,10,0,6" x:Name="BudPairGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="BudImgL" Grid.Column="0" Height="120" Stretch="Uniform"
                                   Source="Assets/Buds/espeon_black_left.png"/>
                            <Image x:Name="BudImgR" Grid.Column="1" Height="120" Stretch="Uniform"
                                   Source="Assets/Buds/espeon_black_right.png"/>
                        </Grid>
                        <Image x:Name="BudImgSingle" Height="120" Stretch="Uniform"
                               Margin="0,10,0,6" Visibility="Collapsed"/>
                        <StackPanel x:Name="ColorDots" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,2,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ProgressBar x:Name="BattBarL" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock Margin="0,6,0,0" FontSize="15">
                                    <Run Text="L " Foreground="{StaticResource MutedBrush}"/><Run x:Name="BattLRun" Text="—"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <ProgressBar x:Name="BattBarR" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock Margin="0,6,0,0" FontSize="15">
                                    <Run Text="R " Foreground="{StaticResource MutedBrush}"/><Run x:Name="BattRRun" Text="—"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BattCaseText" Text="" FontSize="12"
                                   Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="Noise Cancellation" x:Name="NoiseCard">
                    <StackPanel>
                        <TextBlock x:Name="AncSub" Text="—" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="AncNc" GroupName="ANCMODE" CommandParameter="NC"
                                         Tag="&#x25C9;" Style="{StaticResource AncCircle}"
                                         Checked="AncMode_Checked">
                                <TextBlock TextAlignment="Center">Noise<LineBreak/>Cancellation</TextBlock>
                            </RadioButton>
                            <RadioButton x:Name="AncTr" GroupName="ANCMODE" CommandParameter="TR"
                                         Tag="&#x25CC;" Style="{StaticResource AncCircle}"
                                         Checked="AncMode_Checked">
                                <TextBlock TextAlignment="Center">Transparency</TextBlock>
                            </RadioButton>
                            <RadioButton x:Name="AncOff" GroupName="ANCMODE" CommandParameter="OFF"
                                         Tag="&#x2298;" Style="{StaticResource AncCircle}"
                                         Checked="AncMode_Checked">
                                <TextBlock TextAlignment="Center">Off</TextBlock>
                            </RadioButton>
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,10,0,0" x:Name="AncLevelRow">
                            <RadioButton x:Name="LvlLow" Content="Low" GroupName="ANCLEVEL" Tag="3"
                                         Style="{StaticResource AncLevel}" Checked="AncLevel_Checked"/>
                            <RadioButton x:Name="LvlMid" Content="Mid" GroupName="ANCLEVEL" Tag="5"
                                         Style="{StaticResource AncLevel}" Checked="AncLevel_Checked"/>
                            <RadioButton x:Name="LvlHigh" Content="High" GroupName="ANCLEVEL" Tag="4"
                                         Style="{StaticResource AncLevel}" Checked="AncLevel_Checked"/>
                            <RadioButton x:Name="LvlAdapt" Content="Adaptive" GroupName="ANCLEVEL" Tag="6"
                                         Style="{StaticResource AncLevel}" Checked="AncLevel_Checked"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

            <GroupBox Header="Ultra bass" x:Name="BassCard">
                <StackPanel>
                    <TextBlock x:Name="BassSub" Text="—" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="BassEnable" Grid.Column="0" VerticalAlignment="Center"
                                  Checked="Bass_Changed" Unchecked="Bass_Changed"/>
                        <!-- APK-style stepped bar: gray track, muted step dots,
                             white fill on top hiding dots at/below the level -->
                        <Grid x:Name="BassTrack" Grid.Column="1" Margin="14,0,0,0" Height="34"
                              Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                              PreviewMouseLeftButtonDown="BassTrack_Press"
                              PreviewMouseMove="BassTrack_Move"
                              PreviewMouseLeftButtonUp="BassTrack_Release"
                              SizeChanged="BassTrack_Resize">
                            <Border Height="34" CornerRadius="17"
                                    Background="{StaticResource Card2Brush}"/>
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="3" Grid.ColumnSpan="2" Width="8" Height="8"
                                         Fill="{StaticResource MutedBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="5" Grid.ColumnSpan="2" Width="8" Height="8"
                                         Fill="{StaticResource MutedBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="7" Grid.ColumnSpan="2" Width="8" Height="8"
                                         Fill="{StaticResource MutedBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="BassFill" Height="34" CornerRadius="17"
                                    Background="White" HorizontalAlignment="Left"
                                    Width="34" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </GroupBox>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                            CornerRadius="24" Padding="20" Margin="0,0,7,0" MinWidth="200"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="LatencyCheck" Content="Low lag mode"
                                      Checked="Latency_Changed" Unchecked="Latency_Changed"/>
                            <CheckBox x:Name="InEarCheck" Content="In-ear detection"
                                      Checked="InEar_Changed" Unchecked="InEar_Changed"/>
                            <CheckBox x:Name="PersonalAncCheck" Content="Personalized ANC"
                                      Checked="PersonalAnc_Changed" Unchecked="PersonalAnc_Changed"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <GroupBox Grid.Column="1" Header="Equaliser" Margin="7,0,0,0">
                        <ComboBox x:Name="EqCombo" SelectionChanged="EqCombo_SelectionChanged"
                                  DropDownOpened="EqCombo_Opened" DropDownClosed="EqCombo_Closed"
                                  PreviewKeyDown="Combo_EscMark" VerticalAlignment="Center"/>
                    </GroupBox>
                </Grid>

                <GroupBox Header="Find my buds">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="RingL" Content="Ring left" Click="RingL_Click" Width="130"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="RingR" Content="Ring right" Click="RingR_Click" Width="130"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="RingStop" Content="Stop" Click="RingStop_Click" Width="100"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <GroupBox Header="Remembered devices · auto-connect">
                <StackPanel>
                    <ListBox x:Name="RememberedList" Height="70"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="AddDeviceButton" Content="Add device" Click="AddDevice_Click" Width="150"/>
                        <Button x:Name="RemoveDeviceButton" Content="Forget" Click="RemoveDevice_Click" Width="130"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="ScanStatus" Text="" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                    <ListBox x:Name="ScanResults" Height="70" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Controls">
                <CheckBox x:Name="AutoStartCheck" Content="Start with Windows (tray)"
                          Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
